{
  "$schema": "https://json.schemastore.org/staticwebapp.config.json",

  // The API uses the v4 Node programming model (app.http(...) in api/src/functions),
  // where SWA does not reliably infer a runtime and registers no function at all - the
  // site serves fine and every /api route answers 404. Added as a9ab37f, dropped again
  // by e698188 on the theory that run #78's config was known-good; it was not, because
  // the smoke test that would have caught this arrived in that same commit.
  "platform": {
    "apiRuntime": "node:20"
  },

  "auth": {
    "rolesSource": "/api/GetRoles",
    "identityProviders": {
      "customOpenIdConnectProviders": {
        "google": {
          "registration": {
            "clientIdSettingName": "GOOGLE_CLIENT_ID",
            "clientCredential": {
              "clientSecretSettingName": "GOOGLE_CLIENT_SECRET"
            },
            "openIdConnectConfiguration": {
              "wellKnownOpenIdConfiguration": "https://accounts.google.com/.well-known/openid-configuration"
            }
          },
          "login": {
            "nameClaimType": "http://schemas.xmlsoap.org/ws/2005/05/identity/claims/emailaddress",
            "scopes": ["openid", "profile", "email"]
          }
        }
      }
    }
  },

  // "observer" appears beside "curator" on every rule an observer may READ through
  // (migration 0027: board members who need oversight without curation power). Rules
  // already restricted to PATCH/DELETE/POST keep curator alone, so the edge refuses a
  // write before it reaches a function at all.
  //
  // For the rest, this layer admits the request and httpAuth.ts's requireCurator decides:
  // it returns an observer only on GET. That is deliberate rather than lazy - splitting
  // every rule by method would double this file and make ordering load-bearing, and a
  // misordered rule fails silently in the dangerous direction. One server-side gate is
  // checkable by a test; twenty ordered config rules are not.
  "routes": [
    { "route": "/api/words", "allowedRoles": ["curator", "observer"] },
    { "route": "/api/words/*", "methods": ["PATCH", "DELETE"], "allowedRoles": ["curator"] },
    { "route": "/api/words/*", "allowedRoles": ["member"] },
    { "route": "/api/phrases", "allowedRoles": ["curator", "observer"] },
    { "route": "/api/decisions/*", "allowedRoles": ["curator", "observer"] },

    { "route": "/api/contributions", "methods": ["GET"], "allowedRoles": ["curator", "observer"] },
    { "route": "/api/contributions", "methods": ["POST"], "allowedRoles": ["member"] },
    { "route": "/api/contributions/*", "allowedRoles": ["curator", "observer"] },

    { "route": "/api/consensus", "allowedRoles": ["curator", "observer"] },
    { "route": "/api/consensus/*", "allowedRoles": ["curator", "observer"] },

    { "route": "/api/upstream-drift", "allowedRoles": ["curator", "observer"] },
    { "route": "/api/upstream-drift/*", "allowedRoles": ["curator", "observer"] },

    { "route": "/api/assignments/me", "allowedRoles": ["member"] },
    { "route": "/api/assignments", "methods": ["POST"], "allowedRoles": ["curator"] },
    { "route": "/api/assignments/*", "allowedRoles": ["curator", "observer"] },
    { "route": "/api/users", "allowedRoles": ["curator", "observer"] },
    { "route": "/api/users/*", "allowedRoles": ["curator", "observer"] },
    { "route": "/api/user-contributions/*", "allowedRoles": ["curator", "observer"] },

    { "route": "/api/utterances/*", "allowedRoles": ["member"] },
    { "route": "/api/syllables/*", "allowedRoles": ["member"] },

    { "route": "/api/component-requests", "allowedRoles": ["member"] },
    { "route": "/api/grants/me", "allowedRoles": ["member"] },

    { "route": "/api/kaikki-search", "allowedRoles": ["member"] },
    { "route": "/api/vocab-search", "allowedRoles": ["member"] },
    { "route": "/api/recent-words", "allowedRoles": ["curator", "observer"] },
    { "route": "/api/duplicate-check", "allowedRoles": ["curator", "observer"] },

    { "route": "/api/dictionary", "allowedRoles": ["curator", "observer"] },
    { "route": "/api/dictionary/*", "allowedRoles": ["curator", "observer"] },
    { "route": "/api/images/*", "allowedRoles": ["curator", "observer"] },
    { "route": "/api/examples/*", "allowedRoles": ["curator", "observer"] },

    { "route": "/api/maintenance/*", "allowedRoles": ["curator", "observer"] },

    { "route": "/login", "redirect": "/.auth/login/google" },
    { "route": "/logout", "redirect": "/.auth/logout" },

    { "route": "/.auth/login/github", "statusCode": 404 },
    { "route": "/.auth/login/aad", "statusCode": 404 },
    { "route": "/.auth/login/twitter", "statusCode": 404 }
  ],

  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": ["/api/*", "/*.{png,jpg,jpeg,gif,svg,ico,css,js,map,wav,webmanifest,json}"]
  },

  "mimeTypes": {
    ".webmanifest": "application/manifest+json"
  },

  "responseOverrides": {
    "401": { "redirect": "/login", "statusCode": 302 }
  }
}
